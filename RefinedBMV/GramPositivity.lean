import RefinedBMV.Core
import Mathlib.Tactic.Positivity

namespace RefinedBMV

noncomputable def gram44Form (x0 x1 x2 x3 x4 : ℝ) : ℝ :=
  (102/5 : ℝ) * x0 * x0 + (-129/5 : ℝ) * x0 * x1 + (201/5 : ℝ) * x0 * x2 + (-136/5 : ℝ) * x0 * x3 + (-134/5 : ℝ) * x0 * x4 + (-129/5 : ℝ) * x1 * x0 + (293/5 : ℝ) * x1 * x1 + (-71/1 : ℝ) * x1 * x2 + (321/10 : ℝ) * x1 * x3 + (158/5 : ℝ) * x1 * x4 + (201/5 : ℝ) * x2 * x0 + (-71/1 : ℝ) * x2 * x1 + (634/5 : ℝ) * x2 * x2 + (-137/2 : ℝ) * x2 * x3 + (-135/2 : ℝ) * x2 * x4 + (-136/5 : ℝ) * x3 * x0 + (321/10 : ℝ) * x3 * x1 + (-137/2 : ℝ) * x3 * x2 + (228/5 : ℝ) * x3 * x3 + (224/5 : ℝ) * x3 * x4 + (-134/5 : ℝ) * x4 * x0 + (158/5 : ℝ) * x4 * x1 + (-135/2 : ℝ) * x4 * x2 + (224/5 : ℝ) * x4 * x3 + (222/5 : ℝ) * x4 * x4

theorem gram44Form_ldl (x0 x1 x2 x3 x4 : ℝ) :
    gram44Form x0 x1 x2 x3 x4 =
      (102/5 : ℝ) * ((1/1 : ℝ) * x0 + (-43/34 : ℝ) * x1 + (67/34 : ℝ) * x2 + (-4/3 : ℝ) * x3 + (-67/51 : ℝ) * x4)^2 + (883/34 : ℝ) * ((1/1 : ℝ) * x1 + (-3427/4415 : ℝ) * x2 + (-391/4415 : ℝ) * x3 + (-78/883 : ℝ) * x4)^2 + (704959/22075 : ℝ) * ((1/1 : ℝ) * x2 + (-368328/704959 : ℝ) * x3 + (-727105/1409918 : ℝ) * x4)^2 + (8710789/21148770 : ℝ) * ((1/1 : ℝ) * x3 + (5472554/8710789 : ℝ) * x4)^2 + (58147803/174215780 : ℝ) * ((1/1 : ℝ) * x4)^2 := by
  unfold gram44Form
  ring

theorem gram44Form_nonneg (x0 x1 x2 x3 x4 : ℝ) :
    0 ≤ gram44Form x0 x1 x2 x3 x4 := by
  rw [gram44Form_ldl]
  positivity

theorem weights54_positive : (0 : ℝ) < 1 ∧ 0 < (12 : ℝ) ∧ 0 < (5/3 : ℝ) ∧ 0 < (41/10 : ℝ) := by
  norm_num

end RefinedBMV
